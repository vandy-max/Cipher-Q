# CipherQ v18 backend configuration (example only -- contains NO secrets).
# Copy to .env (git-ignored) or inject through your orchestrator's secret store.
#
# Generate secrets with:   python scripts/generate_secrets.py --out /etc/cipherq
# (writes jwt_secret, keyring, active_key_id with mode 0600; never commit them).

# --- Environment ------------------------------------------------------
# development | test | staging | production. staging/production are STRICT:
# the process refuses to start on any unsafe setting below.
APP_ENV=development

# --- Secrets (strict envs: required, from files or the environment) ----
# JWT_SECRET_FILE=/etc/cipherq/jwt_secret
# CIPHERQ_KEYRING_FILE=/etc/cipherq/keyring          # "<id>:<base64 32 bytes>,<id>:..." (or a JSON object)
# CIPHERQ_ACTIVE_KEY_ID=1                             # required when >1 key is present
# CIPHERQ_LEGACY_V1_DB_KEY=                           # only while migrating a v17 database (scripts/reencrypt.py)
# In development, if unset, a random dev secret file is created on first start
# (backend/.dev_secrets.json, mode 0600, git-ignored). It is never used in strict envs.

# --- Database ----------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=cipherq_dev_clean
# Strict envs require credentials + TLS in the URI, e.g.
# MONGODB_URI=mongodb://cipherq_app:<password>@host:27017/cipherq?tls=true&authSource=cipherq
# MONGODB_TLS_CA_FILE=/etc/cipherq/mongo-ca.pem

# --- HTTP surface ------------------------------------------------------
# ALLOWED_ORIGINS=https://app.example.com            # exact origins; required in strict envs
# ALLOWED_HOSTS=api.example.com                      # Host header allow-list; required in strict envs
# TRUSTED_PROXY_COUNT=0                              # number of reverse proxies in front of the API
# ENABLE_DOCS=false                                  # OpenAPI UI (off by default in strict envs)
# ENABLE_HSTS=true
# MAX_BODY_BYTES=16777216  # 16 MiB request ceiling; supports the 1 MiB direct-message attachment cap

# --- Authentication / policy --------------------------------------------
# ALLOW_SELF_REGISTER=true
# JWT_TTL_MINUTES=30
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_SECONDS=900
# ADMIN_SELF_APPROVAL=false                          # keep false: requesters never approve their own intents
# STEPUP_TTL_SECONDS=300
# CHALLENGE_TTL_SECONDS=60
# HEARTBEAT_MAX_GAP_SECONDS=45
# DECISION_TTL_SECONDS=300
# CONTEXT_TTL_SECONDS=120
# KEY_SESSION_TTL_SECONDS=86400  # 24 hours; record retention is also capped at 24 hours

# --- Audit --------------------------------------------------------------
# Append-only secondary sink (ship it off-host). REQUIRED in strict envs.
# AUDIT_SINK_PATH=/var/log/cipherq/audit-sink.jsonl

# --- Quantum (BB84 SIMULATION; not physical QKD) -------------------------
# MAX_QUBITS=2048
# QUANTUM_CONCURRENCY=4
# QUANTUM_PER_USER_PER_HOUR=30
# ALLOW_ATTACK_SIMULATION=false                      # eavesdropper simulation; refused in strict envs

# --- Admin bootstrap -----------------------------------------------------
# There is no default admin. Create the first one explicitly:
#   python scripts/seed_admin.py --username <name> --email <email>      (prompts for the password)
