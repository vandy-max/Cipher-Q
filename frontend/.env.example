# Where the Vite dev-server proxy forwards /api (default http://localhost:8000).
VITE_API_PROXY_TARGET=http://localhost:8000
# Continuous-monitoring heartbeat interval in ms (default 2500). The backend
# expires a monitoring session after HEARTBEAT_MAX_GAP_SECONDS without a valid tick.
# VITE_MONITORING_INTERVAL_MS=2500
VITE_MONITORING_CAMERA_GRACE_MS=8000
